# ==========================================
# BrewLite - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ---- Database ----
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite

# ---- Backend (NestJS) ----
BACKEND_PORT=3001
JWT_SECRET=brewlite-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Docker (PostgreSQL) ----
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
