# Mau chua kich hoat. Doc .github/CI_CD_GUIDE.md truoc khi thay ci.yml.
name: BrewLite CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:
  workflow_call:

permissions:
  contents: read

# Khong dat concurrency o workflow tai su dung: CD quan ly hang doi release.
jobs:
  check:
    name: Check ${{ matrix.app }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        include:
          # TODO: doi directory khi chuyen sang apps/api va apps/web.
          - app: backend
            directory: backend
          - app: frontend
            directory: frontend
    defaults:
      run:
        shell: bash
        working-directory: ${{ matrix.directory }}
    env:
      CI: 'true'
      # Chi dung cho unit test/build; khong ket noi database production.
      DATABASE_URL: postgresql://brewlite:brewlite@localhost:5432/brewlite_test
      JWT_SECRET: ci-only-secret-do-not-use-in-production
      NEXT_PUBLIC_API_URL: http://localhost:3001/api

    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          persist-credentials: false

      - name: Setup Node.js
        uses: actions/setup-node@v7
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: ${{ matrix.directory }}/package-lock.json

      - name: Check required npm scripts
        run: |
          node --input-type=commonjs <<'NODE'
          const { scripts = {} } = require('./package.json');
          for (const name of ['lint', 'test', 'build']) {
            if (typeof scripts[name] !== 'string' || !scripts[name].trim()) {
              console.error(`::error::Missing npm script "${name}". Add its implementation before enabling this CI.`);
              process.exitCode = 1;
            }
          }
          NODE

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma client
        if: matrix.app == 'backend'
        run: npx prisma generate

      - name: Lint
        run: npm run lint

      # npm test phai chay mot lan, khong watch va tra exit code khac 0 khi loi.
      - name: Unit tests
        run: npm test

      - name: Build
        run: npm run build
