// BrewLite Database Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  EWALLET
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProductSize {
  S
  M
  L
}

// ==========================================
// Models
// ==========================================

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  fullName          String?            // Họ và tên
  phone             String?            // Số điện thoại liên hệ
  passwordHash      String
  loyaltyPoints     Int                @default(0)
  emailVerifiedAt   DateTime?          // null = chưa xác minh email
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  orders            Order[]
  addresses         Address[]          // Danh sách địa chỉ giao hàng
  emailVerification EmailVerification?

  @@map("users")
}

model EmailVerification {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String   // Băm (hash) của mã OTP 6 số
  expiresAt  DateTime // Thời điểm hết hạn của mã (10 phút)
  attempts   Int      @default(0) // Số lần nhập sai (giới hạn thử)
  lastSentAt DateTime @default(now()) // Thời điểm gửi OTP gần nhất (chống gửi lại liên tục)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("email_verifications")
}

model Product {
  id            String  @id @default(uuid())
  name          String
  description   String? // Mô tả ngắn (EN/VI)
  imageUrl      String?
  category      String  // "phin", "tra", "freeze", "phindi", "espresso", "other"
  allowToppings Boolean @default(false) // true = cho phép thêm topping
  stock         Int     @default(100)
  version       Int     @default(1) // Optimistic locking
  isAvailable   Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prices     ProductPrice[] // Bảng giá theo size (S/M/L)
  orderItems OrderItem[]

  @@map("products")
}

/// Bảng giá theo từng size của sản phẩm.
/// Một sản phẩm có thể có 1-3 size tùy loại.
/// VD: Trà Sữa Highlands chỉ có M và L (không có S).
model ProductPrice {
  id        String      @id @default(uuid())
  productId String
  size      ProductSize
  price     Int         // VND (đơn vị: đồng)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size]) // Mỗi sản phẩm chỉ có 1 giá cho mỗi size
  @@map("product_prices")
}

/// Topping có thể thêm vào đồ uống.
/// Chỉ những Product có allowToppings=true mới hiển thị danh sách topping.
model Topping {
  id          String  @id @default(uuid())
  name        String  @unique
  price       Int     // VND
  imageUrl    String?
  isAvailable Boolean @default(true)
  createdAt   DateTime @default(now())

  @@map("toppings")
}

model Order {
  id                  String      @id @default(uuid())
  userId              String
  status              OrderStatus @default(PENDING)
  total               Int         // VND
  discount            Int         @default(0) // VND
  promoCode           String?
  loyaltyPointsEarned Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String      @id @default(uuid())
  orderId   String
  productId String
  size      ProductSize @default(S)
  toppings  String[]    // Snapshot tên topping tại thời điểm đặt
  qty       Int         @default(1)
  lineTotal Int         // VND

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  idempotencyKey String        @unique
  amount         Int           // VND
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model Promotion {
  id             String    @id @default(uuid())
  code           String    @unique // Mã giảm giá (ví dụ: BREW10, COFFEE20K)
  description    String?   // Mô tả ưu đãi
  discountType   String    // "PERCENTAGE" (giảm %) hoặc "FIXED_AMOUNT" (giảm tiền cố định)
  discountValue  Float     // Giá trị giảm (10% hoặc 20000đ)
  minOrderValue  Float     @default(0) // Giá trị đơn hàng tối thiểu
  maxDiscount    Float?    // Giảm tối đa (áp dụng cho %)
  startDate      DateTime  @default(now())
  endDate        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}