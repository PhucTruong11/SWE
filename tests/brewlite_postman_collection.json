                  "const beans=list.find(x=>x.code==='COFFEE_BEANS');pm.test('Có hạt cà phê',()=>pm.expect(beans).to.exist);",
                  "if(beans){pm.collectionVariables.set('beanId', beans.id);pm.environment.set('beanId', beans.id);pm.collectionVariables.set('beanOnHandBefore', beans.onHand);pm.environment.set('beanOnHandBefore', beans.onHand);pm.collectionVariables.set('beanReservedBefore', beans.reserved);pm.environment.set('beanReservedBefore', beans.reserved);}"
                ]
