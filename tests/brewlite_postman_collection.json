    {
      "name": "2. Menu và ưu đãi",
      "item": [
        {
          "name": "2.1 Danh sách 6 món",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json(); const list=j.data;",
                  "pm.test('Đúng 6 món',()=>pm.expect(list).to.be.an('array').with.lengthOf(6));",
                  "const phin=list.find(p=>p.name==='Phin Sữa Đá'); const tea=list.find(p=>p.name==='Trà Thanh Đào');",
                  "pm.test('Món mẫu còn bán và đủ nguyên liệu',()=>{pm.expect(phin).to.exist;pm.expect(phin.stock).to.be.above(0);pm.expect(tea).to.exist;});",
                  "if(phin){pm.collectionVariables.set('productId', phin.id);pm.environment.set('productId', phin.id);pm.collectionVariables.set('productPriceS', phin.prices.find(x=>x.size==='S').price);pm.environment.set('productPriceS', phin.prices.find(x=>x.size==='S').price);}",
                  "if(tea){pm.collectionVariables.set('teaProductId', tea.id);pm.environment.set('teaProductId', tea.id);pm.collectionVariables.set('teaPriceS', tea.prices.find(x=>x.size==='S').price);pm.environment.set('teaPriceS', tea.prices.find(x=>x.size==='S').price);}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Danh sách 3 topping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/toppings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const list=pm.response.json().data;",
                  "pm.test('Đúng 3 topping',()=>pm.expect(list).to.be.an('array').with.lengthOf(3));",
                  "const topping=list.find(x=>x.name==='Trân Châu Trắng'); pm.test('Có topping mẫu',()=>pm.expect(topping).to.exist);",
                  "if(topping){pm.collectionVariables.set('toppingId', topping.id);pm.environment.set('toppingId', topping.id);pm.collectionVariables.set('toppingPrice', topping.price);pm.environment.set('toppingPrice', topping.price);}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Chi tiết món",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json().data; pm.test('Đúng món và có giá size S',()=>{pm.expect(p.id).to.equal(pm.variables.get('productId'));pm.expect(p.prices.some(x=>x.size==='S')).to.be.true;});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Danh sách ưu đãi còn hạn",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/promotions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const list=pm.response.json(); pm.test('Chỉ còn hiệu lực',()=>{pm.expect(list).to.be.an('array');list.forEach(p=>{pm.expect(p.isActive).to.be.true;if(p.endDate)pm.expect(Date.parse(p.endDate)).to.be.above(Date.now());});});",
                  "const promo=list.find(p=>p.code==='BREW10')||list[0]; if(promo){pm.collectionVariables.set('promoCode', promo.code);pm.environment.set('promoCode', promo.code);}"
                ]
              }
            }
          ]
        },
