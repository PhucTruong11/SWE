{
  "info": {
    "_postman_id": "9a8f4c20-7b31-4d1e-8e6f-1234567890ab",
    "name": "BrewLite API - danh mục nguyên liệu và thanh toán",
    "description": "Chạy trên DB demo đã migrate, seed/bootstrap và có tồn nguyên liệu. Cần tài khoản ADMIN đã xác minh; có thể đổi adminEmail/adminPassword. Collection tạo một đơn và thanh toán thật trong DB demo, sau đó chuyển COMPLETED. Cổng thanh toán hiện là mock luôn thành công; không kiểm thử PAYMENT_FAILED tự động. Để kiểm tra hết hạn, tạo đơn riêng rồi chờ quá 120 giây trước khi GET /checkout/status/:id. API ghi nguyên liệu/công thức admin chưa có nên chưa đưa vào collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Xác thực",
      "item": [
        {
          "name": "1.1 Đăng nhập tài khoản kiểm thử",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json(); pm.test('Có JWT',()=>pm.expect(j.accessToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', j.accessToken);",
                  "pm.environment.set('token', j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Sai mật khẩu",
