            ],
            "url": "{{baseUrl}}/cart/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"size\": \"S\",\n      \"qty\": 1,\n      \"toppings\": [],\n      \"lineTotal\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
